# Resource-bounded Kiota proof image. Pin the SDK by immutable image digest;
# the approved generator version is restored during the build.
FROM mcr.microsoft.com/dotnet/sdk@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    HOME=/tmp
WORKDIR /repo
# Add the local HTTPS inspection CA only during NuGet restore.
RUN --mount=type=secret,id=nuget_ca --mount=type=tmpfs,target=/run/nuget-trust ["/bin/sh", "-ec", "if [ -f /run/secrets/nuget_ca ]; then cat /etc/ssl/certs/ca-certificates.crt /run/secrets/nuget_ca > /run/nuget-trust/ca.pem; export SSL_CERT_FILE=/run/nuget-trust/ca.pem; fi; dotnet tool install Microsoft.OpenApi.Kiota --tool-path /opt/kiota --version 1.38.0 && /opt/kiota/kiota --version && echo 'ec934c391c94e156543ce63cb497d6944180105b2b794b8b3a53a89b89cd4d82  /opt/kiota/.store/microsoft.openapi.kiota/1.38.0/microsoft.openapi.kiota/1.38.0/microsoft.openapi.kiota.1.38.0.nupkg' | sha256sum -c -"]
# This image has only a .NET 10 runtime; the SDK-installed tool also carries
# net8.0 and net9.0 copies that cannot execute in the final stage. Keep the
# verified nupkg and net10.0 payload, then prove the final CLI still runs.
RUN ["/bin/sh", "-c", "test -d /opt/kiota/.store/microsoft.openapi.kiota/1.38.0/microsoft.openapi.kiota/1.38.0/tools/net10.0 && rm -rf /opt/kiota/.store/microsoft.openapi.kiota/1.38.0/microsoft.openapi.kiota/1.38.0/tools/net8.0 /opt/kiota/.store/microsoft.openapi.kiota/1.38.0/microsoft.openapi.kiota/1.38.0/tools/net9.0"]
# A net10-only launcher retains the cgroup peak-memory proof without requiring
# a shell or coreutils in the minimal runtime. It exits unsuccessfully if the
# kernel measurement is unavailable. No third-party package is restored.
RUN ["/bin/sh", "-c", "mkdir -p /opt/kiota-probe-src && printf '%s\n' '<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><UseAppHost>false</UseAppHost></PropertyGroup></Project>' > /opt/kiota-probe-src/kiota-probe.csproj && printf '%s\n' 'using System;' 'using System.Diagnostics;' 'using System.IO;' 'try {' '  var start = new ProcessStartInfo(\"/opt/kiota/kiota\") { UseShellExecute = false };' '  foreach (var arg in args) start.ArgumentList.Add(arg);' '  using var child = Process.Start(start);' '  if (child is null) return 125;' '  child.WaitForExit();' '  Console.Error.WriteLine(\"STOCKSENSE_GENERATOR_PEAK=\" + File.ReadAllText(\"/sys/fs/cgroup/memory.peak\").Trim());' '  return child.ExitCode;' '} catch { return 125; }' > /opt/kiota-probe-src/Program.cs && dotnet publish /opt/kiota-probe-src/kiota-probe.csproj -c Release -o /opt/kiota-probe -p:RestoreIgnoreFailedSources=true"]
# Run the pinned Kiota tool without build-only SDK and PowerShell packages.
# The final runtime image is smoke-tested and scanned as the exact CI subject.
FROM --platform=linux/amd64 python@sha256:2784af835b90070d9d37d3aa5aa01a3e825d88436b0d58f7776d2cdcb6780f9e AS runtime-build
COPY scripts/build-kiota-runtime.py kiota-runtime-inputs.json /recipe/
RUN --mount=type=secret,id=nuget_ca python /recipe/build-kiota-runtime.py --self-test \
    && python /recipe/build-kiota-runtime.py /recipe/kiota-runtime-inputs.json

FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/runtime@sha256:e7e90bfc3ce16f9efdf18c25c7e4876af4ffba7ea50582878f6ea05b1e04a7ec AS microsoft-payload
FROM scratch
COPY --from=runtime-build /rootfs/ /
COPY --from=microsoft-payload /usr/share/dotnet /usr/share/dotnet
COPY --from=microsoft-payload /etc/passwd /etc/passwd
COPY --from=microsoft-payload /etc/group /etc/group
# .NET's optional LTTng provider targets ABI .so.0, unavailable in Noble.
# Preserve its signed bytes and disable loading through the documented setting.
ENV APP_UID=1654 ASPNETCORE_HTTP_PORTS=8080 DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_VERSION=10.0.15 DOTNET_LTTng=0 COMPlus_LTTng=0
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    HOME=/tmp
WORKDIR /repo
COPY --from=build /opt/kiota /opt/kiota
COPY --from=build /opt/kiota-probe /opt/kiota-probe
RUN ["/opt/kiota/kiota", "--version"]
USER 65532:65532
ENTRYPOINT ["/opt/kiota/kiota"]
