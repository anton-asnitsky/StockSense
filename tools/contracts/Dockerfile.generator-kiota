# Resource-bounded Kiota proof image. Pin the SDK by immutable image digest;
# the approved generator version is restored during the build.
FROM mcr.microsoft.com/dotnet/sdk@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    HOME=/tmp
WORKDIR /repo
RUN ["/bin/sh", "-c", "dotnet tool install Microsoft.OpenApi.Kiota --tool-path /opt/kiota --version 1.35.0 && /opt/kiota/kiota --version && echo '5e75f6adf161717be8d9f39eb596f93d52535e7b8cbcc00cffdcef3d0d3c3486  /opt/kiota/.store/microsoft.openapi.kiota/1.35.0/microsoft.openapi.kiota/1.35.0/microsoft.openapi.kiota.1.35.0.nupkg' | sha256sum -c -"]
# This image has only a .NET 10 runtime; the SDK-installed tool also carries
# net8.0 and net9.0 copies that cannot execute in the final stage. Keep the
# verified nupkg and net10.0 payload, then prove the final CLI still runs.
RUN ["/bin/sh", "-c", "test -d /opt/kiota/.store/microsoft.openapi.kiota/1.35.0/microsoft.openapi.kiota/1.35.0/tools/net10.0 && rm -rf /opt/kiota/.store/microsoft.openapi.kiota/1.35.0/microsoft.openapi.kiota/1.35.0/tools/net8.0 /opt/kiota/.store/microsoft.openapi.kiota/1.35.0/microsoft.openapi.kiota/1.35.0/tools/net9.0"]
# A net10-only launcher retains the cgroup peak-memory proof without requiring
# a shell or coreutils in the chiseled runtime. It exits unsuccessfully if the
# kernel measurement is unavailable. No third-party package is restored.
RUN ["/bin/sh", "-c", "mkdir -p /opt/kiota-probe-src && printf '%s\n' '<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><UseAppHost>false</UseAppHost></PropertyGroup></Project>' > /opt/kiota-probe-src/kiota-probe.csproj && printf '%s\n' 'using System;' 'using System.Diagnostics;' 'using System.IO;' 'try {' '  var start = new ProcessStartInfo(\"/opt/kiota/kiota\") { UseShellExecute = false };' '  foreach (var arg in args) start.ArgumentList.Add(arg);' '  using var child = Process.Start(start);' '  if (child is null) return 125;' '  child.WaitForExit();' '  Console.Error.WriteLine(\"STOCKSENSE_GENERATOR_PEAK=\" + File.ReadAllText(\"/sys/fs/cgroup/memory.peak\").Trim());' '  return child.ExitCode;' '} catch { return 125; }' > /opt/kiota-probe-src/Program.cs && dotnet publish /opt/kiota-probe-src/kiota-probe.csproj -c Release -o /opt/kiota-probe -p:RestoreIgnoreFailedSources=true"]
# Run the pinned Kiota tool without build-only SDK and PowerShell packages.
# The final runtime image is smoke-tested and scanned as the exact CI subject.
FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/runtime:10.0-resolute-chiseled-extra@sha256:17c2dbf23b6e942ed24aef8816d0c03391e91d884bcc7a0799cd4590303cdd01
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    HOME=/tmp
WORKDIR /repo
COPY --from=build /opt/kiota /opt/kiota
COPY --from=build /opt/kiota-probe /opt/kiota-probe
RUN ["/opt/kiota/kiota", "--version"]
USER 65532:65532
ENTRYPOINT ["/opt/kiota/kiota"]
