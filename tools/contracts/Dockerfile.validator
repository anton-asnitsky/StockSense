# Build context: tools/contracts from a clean checkout.
# The base manifest is fixed; the resulting validator image must be built,
# smoke-tested, inspected, and supplied to the runner by its own sha256 digest.
FROM docker.io/library/node@sha256:5098ee834c9345ddd7fc2828a01dc90aa6de0e9ed6804a09a959b19a1fded97a AS dependencies

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NO_UPDATE_NOTIFIER=1 \
    NODE_ENV=production
WORKDIR /opt/contracts
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN corepack enable \
    && corepack prepare pnpm@11.25.0 --activate \
    && pnpm install --prod --frozen-lockfile --ignore-scripts \
    && node node_modules/@redocly/cli/bin/cli.js --version

FROM docker.io/library/node@sha256:5098ee834c9345ddd7fc2828a01dc90aa6de0e9ed6804a09a959b19a1fded97a
# Alpine keeps the current shell and Node entrypoints while reducing the
# runtime package closure. Remove npm/Corepack from the final validator.
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack
ENV NODE_ENV=production \
    NO_UPDATE_NOTIFIER=1 \
    SUPPRESS_NO_CONFIG_WARNING=1 \
    HOME=/tmp
WORKDIR /opt/contracts
COPY --from=dependencies /opt/contracts/package.json /opt/contracts/pnpm-lock.yaml ./
COPY --from=dependencies /opt/contracts/node_modules ./node_modules
COPY src ./src
RUN node --check /opt/contracts/src/container-schema-validator.mjs
RUN node --check /opt/contracts/src/container-fixture-oracle.mjs
RUN node --check /opt/contracts/src/container-asyncapi-validator.mjs
# Record which tool sources this image carries. The runner compares this with
# the tree it is being asked to speak for and refuses a mismatch, so a stale
# image cannot silently report an old tool's verdict as the current one.
RUN node /opt/contracts/src/source-digest.mjs > /opt/contracts/source-digest.txt \
    && cat /opt/contracts/source-digest.txt
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/node"]
CMD ["--version"]
