# Build context: tools/contracts from a clean checkout. Keep the approved,
# immutable Node build image; the final Linux/amd64 runtime is distroless.
FROM docker.io/library/node@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS dependencies

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NO_UPDATE_NOTIFIER=1 \
    NODE_ENV=production
WORKDIR /opt/contracts
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN corepack enable \
    && corepack prepare pnpm@11.25.0 --activate \
    && pnpm install --prod --frozen-lockfile --ignore-scripts \
    && node node_modules/@redocly/cli/bin/cli.js --version
COPY src ./src
COPY Dockerfile.validator ./Dockerfile.validator
RUN node --check src/container-schema-validator.mjs \
    && node --check src/container-fixture-oracle.mjs \
    && node --check src/container-asyncapi-validator.mjs \
    && node --check src/container-tool-launcher.mjs \
    && node src/source-digest.mjs > source-digest.txt

# Official linux/amd64 manifest, Node 24.22.1. No shell or cat is available.
FROM --platform=linux/amd64 gcr.io/distroless/nodejs24-debian13:nonroot@sha256:4d0e659ef1f628c75d9940766cb444fa9605cc190b13676b9e62e1fa567c5cf4
ENV NODE_ENV=production \
    NO_UPDATE_NOTIFIER=1 \
    SUPPRESS_NO_CONFIG_WARNING=1 \
    HOME=/tmp
WORKDIR /opt/contracts
COPY --from=dependencies /opt/contracts/package.json /opt/contracts/pnpm-lock.yaml ./
COPY --from=dependencies /opt/contracts/node_modules ./node_modules
COPY --from=dependencies /opt/contracts/src ./src
COPY --from=dependencies /opt/contracts/source-digest.txt ./source-digest.txt
USER 65532:65532
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["--version"]
