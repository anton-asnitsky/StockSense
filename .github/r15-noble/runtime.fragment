FROM --platform=linux/amd64 python@sha256:2784af835b90070d9d37d3aa5aa01a3e825d88436b0d58f7776d2cdcb6780f9e AS cut
COPY chisel /usr/local/bin/chisel
COPY chisel-wrapper /usr/local/bin/chisel-wrapper
COPY slices/ /slices/
COPY snapshot_cut.py /recipe/snapshot_cut.py
RUN chmod 755 /usr/local/bin/chisel /usr/local/bin/chisel-wrapper && python /recipe/snapshot_cut.py && mkdir -p /rootfs/usr/bin && ln -s /usr/share/dotnet/dotnet /rootfs/usr/bin/dotnet

FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/runtime@sha256:e7e90bfc3ce16f9efdf18c25c7e4876af4ffba7ea50582878f6ea05b1e04a7ec AS microsoft_payload
FROM scratch AS runtime
COPY --from=cut /rootfs/ /
COPY --from=microsoft_payload /usr/share/dotnet /usr/share/dotnet
COPY --from=microsoft_payload /etc/passwd /etc/passwd
COPY --from=microsoft_payload /etc/group /etc/group
ENV APP_UID=1654 ASPNETCORE_HTTP_PORTS=8080 DOTNET_RUNNING_IN_CONTAINER=true DOTNET_VERSION=10.0.15 DOTNET_LTTng=0 COMPlus_LTTng=0
